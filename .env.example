# Provider API keys (Job A). Fill in at least one; see README for the pool.
NVIDIA_NIM_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=           # optional: billing dead, kept only for pool parity

# LLM configuration
PRAXIS_MODEL=groq/openai/gpt-oss-20b

# Design/plan chain (comma-separated, tried left to right on rate limits and
# request-too-large rejections). Default if unset: groq/openai/gpt-oss-120b.
# PRAXIS_DESIGN_MODEL=nvidia_nim/nvidia/nemotron-3-super-120b-a12b,groq/openai/gpt-oss-120b,openrouter/nvidia/nemotron-3.5-lightning:free

# Coder stage (optional): off = stop at the blueprint (use `praxis export <id>`
# to hand it to any coding agent); opencode = draft prototypes via an
# OpenCode-compatible CLI. Per-run override: `praxis run --prototype` or
# `--no-prototype`. The CLI and the gateway config below are only needed when
# the Coder is enabled.
PRAXIS_CODER=off

# Storage
PRAXIS_DB_PATH=./praxis.db
PRAXIS_DB_URL=

# Hardware profile (optional; falls back to hardware_profile.yaml, then defaults)
PRAXIS_CONFIG=./hardware_profile.yaml
PRAXIS_CPU_ONLY=true
PRAXIS_RAM_GB=8
PRAXIS_GPU=false
PRAXIS_MONTHLY_BUDGET_USD=15

# Provider pool: 3 API keys for Job A. Job B (only with PRAXIS_CODER=opencode)
# routes through the omniroute gateway; its keys live in the gateway, not here.
#
#   Job A (Analyst + Architect + design passes — litellm, Praxis env):
#     NVIDIA_NIM_API_KEY, GROQ_API_KEY, OPENROUTER_API_KEY
#     (CEREBRAS_API_KEY optional: billing dead, not in the design chain)
#   Job B (Coder — OpenCode CLI, optional):
#     opencode owns no direct provider keys; the gateway at
#     localhost:20128 (see ~/.config/opencode/opencode.json) handles them
#     and does backend-level failover internally.
#
# Per-provider key overrides (Job A only; litellm uses these when set):
# PRAXIS_NVIDIA_NIM_API_KEY=
# PRAXIS_GROQ_API_KEY=
# PRAXIS_OPENROUTER_API_KEY=
# PRAXIS_CEREBRAS_API_KEY=

# Provider ordering for Job A (comma-separated; primary model's provider tried
# first, then fallbacks in pool preference order).
# PRAXIS_PROVIDERS=groq,openrouter

# How long (seconds) an exhausted provider stays in cooldown before re-trying.
PRAXIS_PROVIDER_COOLDOWN_S=60

# Job B (only used when the Coder is enabled): Coder model rotation
# (comma-separated opencode model ids, all under the omniroute provider). Try
# the next model instantly on exhaustion, bounded by retries. The gateway owns
# the backends, so Praxis only rotates ids.
# PRAXIS_CODER_MODELS=omniroute/deepseek-flash,omniroute/auto/best-coding,omniroute/auto/pro-coding
PRAXIS_CODER_PROVIDER_RETRIES=3

# Extra flags for `opencode run`. Stock opencode uses --auto; set to empty for
# forks whose `opencode run` is non-interactive and rejects unknown flags.
PRAXIS_CODER_OPENCODE_FLAGS=--auto
