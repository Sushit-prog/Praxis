# LLM configuration
PRAXIS_MODEL=groq/llama-3.1-8b-instant

# Storage
PRAXIS_DB_PATH=./praxis.db
PRAXIS_DB_URL=

# Hardware profile (optional; falls back to hardware_profile.yaml, then defaults)
PRAXIS_CONFIG=./hardware_profile.yaml
PRAXIS_CPU_ONLY=true
PRAXIS_RAM_GB=8
PRAXIS_GPU=false
PRAXIS_MONTHLY_BUDGET_USD=15
